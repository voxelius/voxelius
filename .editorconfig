root = true

[*]
end_of_line = crlf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4

[{GNUmakefile,GNUmakefile.*,*.mk}]
indent_style = tab

[*.lua]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonc,json5}]
indent_style = space
indent_size = 2

[*.{css}]
indent_style = space
indent_size = 2
